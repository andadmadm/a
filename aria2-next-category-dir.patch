@@ -63,6 +64,18 @@ std::optional<Task::Moves> Task::relocation(const std::string&) const
 
 void Task::relocated(const std::string& dir) { options().set("dir", dir); }
 
+std::string Task::outputDirectory(std::string_view name,
+                                  bool explicitName) const
+{
+  const auto dir = options_->get("dir");
+  const auto bit = explicitName ? CategoryScopeOut : CategoryScopeAutomatic;
+  if ((static_cast<unsigned>(options_->integer("category-dir-scope")) & bit) ==
+      0) {
+    return dir;
+  }
+  return categoryDirectory(dir, name, options_->get("category-dir"));
+}
+
 bool Task::changeUris(int, const std::vector<std::string>&,
                       const std::vector<std::string>&, int)
 {
