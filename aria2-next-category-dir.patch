diff --git a/tests/CategoryTest.cc b/tests/CategoryTest.cc
new file mode 100644
index 0000000..eb8f3fe
--- /dev/null
+++ b/tests/CategoryTest.cc
@@ -0,0 +1,91 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+#include "base/Category.h"
+#include "base/Path.h"
+
+#include <doctest/doctest.h>
+
+using namespace aria2;
+
+TEST_CASE("category rules parse the zero syntax")
+{
+  const auto rules = parseCategoryDirs("archive:.zip,.rar;text:.txt,.md");
+  REQUIRE(rules.size() == 2);
+  CHECK(rules[0].directory == "archive");
+  CHECK(rules[0].suffixes == std::vector<std::string>{".zip", ".rar"});
+  CHECK(rules[1].directory == "text");
+  CHECK(rules[1].suffixes == std::vector<std::string>{".txt", ".md"});
+}
+
+TEST_CASE("category rules accept repeats and config file lines")
+{
+  // A repeated option arrives as one value per line, as does one entry per
+  // line in a configuration file.
+  const auto rules =
+      parseCategoryDirs("archive:.zip\n;text:.txt\n\nvideo:.mkv,.mp4;");
+  REQUIRE(rules.size() == 3);
+  CHECK(rules[0].directory == "archive");
+  CHECK(rules[1].directory == "text");
+  CHECK(rules[2].suffixes == std::vector<std::string>{".mkv", ".mp4"});
+}
+
+TEST_CASE("category rules normalise spacing and trailing separators")
+{
+  const auto rules = parseCategoryDirs("  archive  : .zip , .rar ,  ");
+  REQUIRE(rules.size() == 1);
+  CHECK(rules[0].directory == "archive");
+  CHECK(rules[0].suffixes == std::vector<std::string>{".zip", ".rar"});
+
+  CHECK(parseCategoryDirs("archive:.zip").at(0).directory == "archive");
+  // A nested category keeps its separators.
+  CHECK(parseCategoryDirs("media/incoming:.mkv").at(0).directory ==
+        "media/incoming");
+}
+
+TEST_CASE("category rules drop unusable entries")
+{
+  // Nothing to match, nowhere safe to go.
+  CHECK(parseCategoryDirs("").empty());
+  CHECK(parseCategoryDirs("archive").empty());
+  CHECK(parseCategoryDirs("archive:").empty());
+  CHECK(parseCategoryDirs("archive:,,").empty());
+  CHECK(parseCategoryDirs("../escape:.zip").empty());
+  CHECK(parseCategoryDirs("a/../../escape:.zip").empty());
+  CHECK(parseCategoryDirs("/absolute:.zip").empty());
+  CHECK(parseCategoryDirs(".:.zip").empty());
+}
+
+TEST_CASE("category directory matches the file name suffix")
+{
+  const std::string spec = "archive:.zip,.rar;text:.txt";
+  const std::string dir = "downloads";
+  CHECK(categoryDirectory(dir, "film.zip", spec) == joinPath(dir, "archive"));
+  // The zero rules are the same, matched without regard to case.
+  CHECK(categoryDirectory(dir, "FILM.ZIP", spec) == joinPath(dir, "archive"));
+  CHECK(categoryDirectory(dir, "notes.txt", spec) == joinPath(dir, "text"));
+  // No rule matches: the download stays in --dir.
+  CHECK(categoryDirectory(dir, "film.zip", "") == dir);
+  CHECK(categoryDirectory(dir, "film.mkv", spec) == dir);
+  // A suffix matches the end of the name, not a part in the middle.
+  CHECK(categoryDirectory(dir, "zip.list", spec) == dir);
+  // --out may name a subdirectory; the rule still reads the file name.
+  CHECK(categoryDirectory(dir, toUtf8(toPath("series") / "first.zip"), spec) ==
+        joinPath(dir, "archive"));
+}
+
+TEST_CASE("category directory keeps a name that is already categorised")
+{
+  const std::string spec = "archive:.zip";
+  const std::string dir = "downloads";
+  // --out may name the category itself; deciding again must not nest the
+  // file in archive/archive.
+  CHECK(categoryDirectory(dir, joinPath("archive", "film.zip"), spec) == dir);
+  CHECK(categoryDirectory(dir, "archive/film.zip", spec) == dir);
+}
+
+TEST_CASE("category directory leaves absolute names alone")
+{
+  // --dir cannot move a file the caller placed absolutely.
+  const auto absolute = toUtf8(fs::absolute(toPath("film.zip")));
+  CHECK(categoryDirectory("downloads", absolute, "archive:.zip") ==
+        "downloads");
+}
