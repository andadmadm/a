diff --git a/src/base/Category.cc b/src/base/Category.cc
new file mode 100644
index 000000000..431e4ac2c
--- /dev/null
+++ b/src/base/Category.cc
@@ -0,0 +1,105 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+#include "base/Category.h"
+
+#include "base/Path.h"
+#include "base/Text.h"
+
+#include <algorithm>
+#include <cctype>
+#include <utility>
+
+namespace aria2 {
+namespace {
+
+bool endsWithIgnoringCase(std::string_view text, std::string_view suffix)
+{
+  if (suffix.empty() || suffix.size() > text.size()) {
+    return false;
+  }
+  const auto offset = text.size() - suffix.size();
+  return std::equal(suffix.begin(), suffix.end(), text.begin() + offset,
+                    [](char a, char b) {
+                      return std::tolower(static_cast<unsigned char>(a)) ==
+                             std::tolower(static_cast<unsigned char>(b));
+                    });
+}
+
+// A category stays below --dir: "..", a drive or a root would save the file
+// somewhere else entirely.
+bool usableDirectory(std::string_view directory)
+{
+  return !directory.empty() && directory != "." &&
+         isContainedRelativePath(directory);
+}
+
+void parseRules(std::string_view value, std::vector<CategoryRule>& rules)
+{
+  for (const auto& entry : text::split(value, ';')) {
+    const std::string_view rule(entry);
+    const auto colon = rule.find(':');
+    if (colon == std::string_view::npos) {
+      continue;
+    }
+    std::string directory(text::trim(rule.substr(0, colon)));
+    while (!directory.empty() && directory.back() == '/') {
+      directory.pop_back();
+    }
+    if (!usableDirectory(directory)) {
+      continue;
+    }
+    CategoryRule parsed{.directory = std::move(directory)};
+    for (const auto& suffix : text::split(rule.substr(colon + 1), ',')) {
+      auto trimmed = std::string(text::trim(suffix));
+      if (!trimmed.empty()) {
+        parsed.suffixes.push_back(std::move(trimmed));
+      }
+    }
+    if (!parsed.suffixes.empty()) {
+      rules.push_back(std::move(parsed));
+    }
+  }
+}
+
+} // namespace
+
+std::vector<CategoryRule> parseCategoryDirs(std::string_view spec)
+{
+  std::vector<CategoryRule> rules;
+  for (const auto& line : text::split(spec, '\n')) {
+    parseRules(line, rules);
+  }
+  return rules;
+}
+
+std::string categoryDirectory(std::string_view dir, std::string_view name,
+                              std::string_view spec)
+{
+  if (spec.empty() || name.empty()) {
+    return std::string(dir);
+  }
+  const auto path = toPath(name);
+  if (path.is_absolute() || path.has_root_name()) {
+    return std::string(dir);
+  }
+  // A rule matches the file name, not the subdirectory --out may name.
+  const auto file = toUtf8(path.filename());
+  for (const auto& rule : parseCategoryDirs(spec)) {
+    const auto matches =
+        std::any_of(rule.suffixes.begin(), rule.suffixes.end(),
+                    [&file](const std::string& suffix) {
+                      return endsWithIgnoringCase(file, suffix);
+                    });
+    if (!matches) {
+      continue;
+    }
+    // --out may already name the category, as in "archive/film.zip".
+    if (text::istartsWith(name, rule.directory + "/") ||
+        text::istartsWith(name, rule.directory + "\\")) {
+      return std::string(dir);
+    }
+    return joinPath(dir, rule.directory);
+  }
+  return std::string(dir);
+}
+
+} // namespace aria2
diff --git a/src/base/Category.h b/src/base/Category.h
new file mode 100644
index 000000000..e8dfa8a62
--- /dev/null
+++ b/src/base/Category.h
@@ -0,0 +1,35 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace aria2 {
+
+// One --category-dir rule: a download whose file name ends with one of
+// `suffixes` is saved in `directory`, a relative path below --dir.
+struct CategoryRule {
+  std::string directory;
+  std::vector<std::string> suffixes;
+};
+
+// Bits of --category-dir-scope, selecting which names a rule may move.
+inline constexpr unsigned CategoryScopeAutomatic = 1; // from the URI or server
+inline constexpr unsigned CategoryScopeOut = 2;       // given with --out
+
+// Parses --category-dir. A value holds rules separated by ';', each written
+// as "DIRECTORY:.SUFFIX,.SUFFIX"; repeated values and line breaks in a
+// configuration file are equally accepted. Spaces around a directory and a
+// suffix are ignored and suffixes match without regard to case. A rule with
+// no suffix, or whose directory is absolute or leaves --dir, is dropped.
+std::vector<CategoryRule> parseCategoryDirs(std::string_view spec);
+
+// The directory a download named `name` belongs in: `dir` itself, or dir/DIR
+// for the first matching rule. A `name` that is absolute leaves the choice to
+// the caller, and one that already starts with its category keeps `dir`, so
+// joining `name` again does not nest the file twice.
+std::string categoryDirectory(std::string_view dir, std::string_view name,
+                              std::string_view spec);
+
+} // namespace aria2
