diff --git a/src/http/NoProxy.cc b/src/http/NoProxy.cc
new file mode 100644
index 000000000..0f4abd22b
--- /dev/null
+++ b/src/http/NoProxy.cc
@@ -0,0 +1,105 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+// Which hosts reach the network directly while a proxy is configured:
+// --no-proxy and --no-proxy-list.
+#include "http/NoProxy.h"
+
+#include "base/Text.h"
+
+#include <algorithm>
+#include <regex>
+#include <utility>
+
+namespace aria2::http {
+namespace {
+
+// libcurl matches a bare domain against the host and every name below it, but
+// reads a *.glob literally, so a glob is resolved here.
+std::string globPattern(std::string_view glob)
+{
+  std::string pattern;
+  for (const char c : glob) {
+    if (c == '*') {
+      pattern += ".*";
+      continue;
+    }
+    if (std::string_view(".^$|()[]{}+?\\").find(c) != std::string_view::npos) {
+      pattern += '\\';
+    }
+    pattern += c;
+  }
+  return pattern;
+}
+
+void append(std::vector<std::string>& rules, std::string rule)
+{
+  if (rule.empty() ||
+      std::find(rules.begin(), rules.end(), rule) != rules.end()) {
+    return;
+  }
+  rules.push_back(std::move(rule));
+}
+
+} // namespace
+
+std::string normalizeNoProxyDomain(std::string_view entry)
+{
+  auto domain = text::lower(text::trim(entry));
+  for (const std::string_view wildcard : {"*.", "."}) {
+    if (domain.starts_with(wildcard)) {
+      domain.erase(0, wildcard.size());
+      break;
+    }
+  }
+  while (domain.ends_with('.')) {
+    domain.pop_back();
+  }
+  // A path, a URL or a glob anywhere but the front names no host.
+  if (domain.empty() || domain == "." || domain == ".." ||
+      domain.find_first_of("/* \t") != std::string::npos) {
+    return {};
+  }
+  return domain;
+}
+
+std::vector<std::string> parseNoProxyList(std::string_view spec)
+{
+  std::vector<std::string> domains;
+  const auto separated = text::replaceAll(
+      text::replaceAll(std::string(spec), ";", ","), "\n", ",");
+  for (const auto& entry : text::split(separated, ',')) {
+    append(domains, normalizeNoProxyDomain(entry));
+  }
+  return domains;
+}
+
+std::string noProxyRules(std::string_view noProxy, std::string_view list,
+                         std::string_view host)
+{
+  std::vector<std::string> rules;
+  const auto separated =
+      text::replaceAll(std::string(noProxy), ";", ",");
+  for (const auto& entry : text::split(separated, ',')) {
+    const auto rule = text::trim(entry);
+    if (rule == "*") {
+      // No host uses the proxy, so no further rule can change the answer.
+      return "*";
+    }
+    if (rule.find('*') == std::string_view::npos) {
+      append(rules, std::string(rule));
+      continue;
+    }
+    // A glob in --no-proxy has always named this request's host or nothing.
+    if (host.empty() || !std::regex_match(std::string(host),
+                                          std::regex(globPattern(rule),
+                                                     std::regex::icase))) {
+      continue;
+    }
+    append(rules, std::string(host));
+  }
+  for (auto& domain : parseNoProxyList(list)) {
+    append(rules, std::move(domain));
+  }
+  return text::join(rules, ",");
+}
+
+} // namespace aria2::http
diff --git a/src/http/NoProxy.h b/src/http/NoProxy.h
new file mode 100644
index 000000000..813b5f537
--- /dev/null
+++ b/src/http/NoProxy.h
@@ -0,0 +1,28 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+#pragma once
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace aria2::http {
+
+// One --no-proxy-list entry in the form libcurl matches it: lower case and
+// without a leading "." or "*." wildcard, which already means the domain and
+// everything below it. Empty when the entry cannot name a host.
+std::string normalizeNoProxyDomain(std::string_view entry);
+
+// The domains of a --no-proxy-list value, separated by commas, semicolons or
+// line breaks, in the order given and without repeats. An entry that cannot
+// name a host (empty, a URL, a glob that is not a *.domain prefix) is dropped.
+std::vector<std::string> parseNoProxyList(std::string_view spec);
+
+// The value for CURLOPT_NOPROXY: --no-proxy followed by --no-proxy-list, so a
+// host named in either one reaches the network without the proxy. `*` in
+// --no-proxy keeps meaning "no host uses the proxy" and wins over everything
+// else. A *.glob in --no-proxy applies to `host` alone, as aria2 always did,
+// so it is replaced by `host` when it matches and dropped when it does not.
+std::string noProxyRules(std::string_view noProxy, std::string_view list,
+                         std::string_view host);
+
+} // namespace aria2::http
