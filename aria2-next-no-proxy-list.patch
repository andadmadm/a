diff --git a/tests/NoProxyTest.cc b/tests/NoProxyTest.cc
new file mode 100644
index 000000000..4b3d9d6d4
--- /dev/null
+++ b/tests/NoProxyTest.cc
@@ -0,0 +1,75 @@
+/* Copyright (C) 2026 aria2-next contributors. GPL-2.0-or-later. */
+#include "http/NoProxy.h"
+
+#include <doctest/doctest.h>
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+using namespace aria2;
+using namespace std::string_view_literals;
+
+TEST_CASE("no-proxy list entries become bare domains")
+{
+  const auto domains = http::parseNoProxyList("nvidia.com,*.AMD.com; .intel.cn ");
+  REQUIRE(domains.size() == 3);
+  CHECK(domains[0] == "nvidia.com");
+  // The *.domain form already means the domain and its subdomains.
+  CHECK(domains[1] == "amd.com");
+  CHECK(domains[2] == "intel.cn");
+  // Repeats and different separators name the same host once.
+  CHECK(http::parseNoProxyList("amd.com\nAMD.COM,amd.com"sv) ==
+        std::vector<std::string>{"amd.com"});
+  // A configuration file arrives as one value per line.
+  CHECK(http::parseNoProxyList("a.example\nb.example") ==
+        std::vector<std::string>{"a.example", "b.example"});
+}
+
+TEST_CASE("no-proxy list entries that name no host are dropped")
+{
+  CHECK(http::parseNoProxyList("").empty());
+  CHECK(http::parseNoProxyList(" , ; \n ").empty());
+  // A path, a URL and a glob that is not a *.domain prefix are not hosts.
+  CHECK(http::parseNoProxyList("https://example.com/file").empty());
+  CHECK(http::parseNoProxyList("example.com/download").empty());
+  CHECK(http::parseNoProxyList("exa*mple.com").empty());
+  CHECK(http::parseNoProxyList("*").empty());
+}
+
+TEST_CASE("no-proxy list adds to --no-proxy in the order given")
+{
+  CHECK(http::noProxyRules("localhost, 10.0.0.0/8", "nvidia.com,amd.com",
+                           "cdn.example.com") ==
+        "localhost,10.0.0.0/8,nvidia.com,amd.com");
+  // A host named twice is bypassed once.
+  CHECK(http::noProxyRules("nvidia.com", "NVIDIA.com,amd.com",
+                           "cdn.example.com") == "nvidia.com,amd.com");
+}
+
+TEST_CASE("an empty no-proxy list leaves --no-proxy alone")
+{
+  // The list is empty by default, so a configuration without it keeps the
+  // rules it always had, and no rules still means no bypass.
+  CHECK(http::noProxyRules("localhost", "", "example.com") == "localhost");
+  CHECK(http::noProxyRules("", "", "example.com").empty());
+}
+
+TEST_CASE("no-proxy * keeps meaning that no host uses the proxy")
+{
+  CHECK(http::noProxyRules("*", "nvidia.com", "example.com") == "*");
+  CHECK(http::noProxyRules("localhost;*", "", "example.com") == "*");
+}
+
+TEST_CASE("no-proxy globs apply to the request host only")
+{
+  const auto matching =
+      http::noProxyRules("*.corp.example", "", "a.corp.example");
+  CHECK(matching == "a.corp.example");
+  // libcurl would read the glob literally and never match, so it is dropped.
+  const auto other =
+      http::noProxyRules("*.corp.example", "", "corp.example.net");
+  CHECK(other.empty());
+  // An empty host cannot satisfy a glob.
+  CHECK(http::noProxyRules("*.corp.example", "", "").empty());
+}
